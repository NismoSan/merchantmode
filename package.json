{
  "name": "merchantmode",
  "version": "1.1.6",
  "description": "Dark Ages AFK Merchant Automation App",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "electron:dev": "vite build && tsc -p tsconfig.node.json && node scripts/launch-electron.js",
    "preview": "vite preview",
    "dist": "npm run build && tsc -p tsconfig.node.json && electron-builder --win --publish always",
    "dist:local": "npm run build && tsc -p tsconfig.node.json && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.merchantmode.app",
    "productName": "Merchant Mode",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "!node_modules/**/docs/**",
      "!node_modules/**/test/**"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/koffi/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": null
    },
    "publish": {
      "provider": "github",
      "owner": "NismoSan",
      "repo": "merchantmode"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NismoSan/merchantmode.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/NismoSan/merchantmode/issues"
  },
  "homepage": "https://github.com/NismoSan/merchantmode#readme",
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-md5": "^0.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "cross-env": "^10.1.0",
    "electron": "^41.0.2",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "electron-updater": "^6.8.3",
    "iconv-lite": "^0.7.2",
    "js-md5": "^0.8.3",
    "koffi": "^2.15.2",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1"
  }
}
